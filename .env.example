# Gatus Railway deployment — environment variables

# ----------------------------------------------------
# 1. Alerting Provider Credentials (Required for Alerts)
# ----------------------------------------------------
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
PAGERDUTY_INTEGRATION_KEY=your-32-character-pagerduty-key

# ----------------------------------------------------
# 2. Optional Dashboard Security (Basic Auth)
# ----------------------------------------------------
# GATUS_ADMIN_USERNAME=admin
# GATUS_ADMIN_PASSWORD=your-secure-password

# ----------------------------------------------------
# 3. System Defaults (Handled automatically by Railway)
# ----------------------------------------------------
PORT=8080
GATUS_CONFIG_PATH=/data/config.yaml
