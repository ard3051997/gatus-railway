# Gatus Railway deployment — example environment variables
# Copy to .env and fill in your own values; or set these in the Railway dashboard.

# Port the Gatus HTTP server listens on. Railway will route public traffic to this port.
PORT=8080

# Path inside the container where Gatus reads its config from. The entrypoint writes
# config.yaml here on every boot (from GATUS_CONFIG_YAML, or from the baked-in default).
GATUS_CONFIG_PATH=/data/config.yaml

# Optional: full YAML configuration for Gatus. If set, this overrides the default
# config on every container restart. Supports Gatus's own ${VAR_NAME} env-var
# substitution inside the YAML.
# GATUS_CONFIG_YAML=

# Optional: HTTP Basic Auth credentials. If both are set, the entrypoint injects
# a security.basic block into config.yaml with a bcrypt-hashed password.
# Leave blank to disable auth (status page is publicly accessible).
# GATUS_ADMIN_USERNAME=admin
# GATUS_ADMIN_PASSWORD=replace-me
